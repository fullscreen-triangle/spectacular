{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spectacular view spec (spectacular/v0)",
  "type": "object",
  "required": [
    "data",
    "views"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": "spectacular/v0"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "format": {
              "enum": [
                "csv",
                "tsv",
                "json"
              ]
            },
            "pointer": {
              "type": "string",
              "pattern": "^(/.*)?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "values"
          ],
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "columns"
          ],
          "properties": {
            "columns": {
              "const": "external"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [],
        "properties": {
          "type": {
            "enum": [
              "quantitative",
              "nominal"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "x",
              "y"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "scatter"
              },
              "title": {
                "type": "string"
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "span": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "x": {
                "type": "string",
                "minLength": 1,
                "description": "the name of a field in the data"
              },
              "y": {
                "type": "string",
                "minLength": 1,
                "description": "the name of a field in the data"
              },
              "color": {
                "type": "string",
                "minLength": 1,
                "description": "the name of a field in the data"
              },
              "brush": {
                "enum": [
                  "xy",
                  "none"
                ]
              },
              "pointSize": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "field"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "histogram"
              },
              "title": {
                "type": "string"
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "span": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "description": "the name of a field in the data"
              },
              "brush": {
                "enum": [
                  "x",
                  "none"
                ]
              },
              "bins": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "field"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "bars"
              },
              "title": {
                "type": "string"
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "span": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "description": "the name of a field in the data"
              },
              "brush": {
                "enum": [
                  "select",
                  "none"
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "x",
              "y"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "density"
              },
              "title": {
                "type": "string"
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "span": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "x": {
                "type": "string",
                "minLength": 1,
                "description": "the name of a field in the data"
              },
              "y": {
                "type": "string",
                "minLength": 1,
                "description": "the name of a field in the data"
              },
              "bins": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1024
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "x",
              "y",
              "z"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "scatter3d"
              },
              "title": {
                "type": "string"
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "span": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "x": {
                "type": "string",
                "minLength": 1,
                "description": "the name of a field in the data"
              },
              "y": {
                "type": "string",
                "minLength": 1,
                "description": "the name of a field in the data"
              },
              "z": {
                "type": "string",
                "minLength": 1,
                "description": "the name of a field in the data"
              },
              "color": {
                "type": "string",
                "minLength": 1,
                "description": "the name of a field in the data"
              },
              "pointSize": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "layout": {
      "type": "object",
      "required": [],
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [],
      "properties": {
        "interactive": {
          "type": "boolean"
        },
        "figure": {
          "type": "object",
          "required": [
            "format",
            "width"
          ],
          "properties": {
            "format": {
              "enum": [
                "png",
                "pdf"
              ]
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "enum": [
                "mm",
                "in",
                "px"
              ]
            },
            "dpi": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
